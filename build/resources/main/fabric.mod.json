{
  "schemaVersion": 1,
  "id": "hadestown",
  "version": "0.0.1",
  "name": "Hadestown Mod",
  "description": "Scene controls and production tools for Hadestown",
  "authors": [
    "R1shy"
  ],
  "contact": {
    "sources": "https://github.com/R1shy/HTMod"
  },
  "license": "MIT",
  "icon": "assets/hadestown/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.rishy.hadestown.client.HadestownDataGenerator"
    ],
    "client": [
      "net.rishy.hadestown.client.HadestownClient"
    ],
    "main": [
      "net.rishy.hadestown.Hadestown"
    ]
  },
  "mixins": [
