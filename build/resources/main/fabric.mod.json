      "config": "hadestown.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "26.2",
    "worldedit": ">=7.4.5"
